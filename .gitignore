# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/
.envrc

# Build and packaging artifacts
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# Logs
logs/*
*.log
!logs/.gitkeep

# Generated recon data and reports
data/raw/*
data/processed/*
reports/screenshots/
reports/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!reports/.gitkeep

# Secrets and local environment files
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/

# Editor and OS files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
